# Local development can use SQLite by leaving DATABASE_URL unset.
# Cloud deployment should set this to your managed PostgreSQL connection string.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
SECRET_KEY=replace-with-a-long-random-secret
COOKIE_SECURE=1
FLASK_DEBUG=0
PORT=5000

# Abuse guards (optional; these are the defaults)
LOGIN_ATTEMPT_LIMIT=12
REGISTER_ATTEMPT_LIMIT=20

